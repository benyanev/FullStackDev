# Caddy — HTTPS in front of the app on AWS (see docker-compose.aws.yml).
# Gets and renews a Let's Encrypt certificate for $DOMAIN automatically and
# redirects http:// to https://.

{$DOMAIN} {
	encode gzip
	# Browsers remember to always use HTTPS for this site
	header Strict-Transport-Security "max-age=31536000"
	reverse_proxy frontend:80
}
