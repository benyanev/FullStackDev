# ==========================================
# Database Configuration
# ==========================================
DB_HOST=localhost
DB_USER=root
# Enter your MySQL database password below
DB_PASSWORD=
DB_NAME=social_app

# ==========================================
# Flask & Security Configuration
# ==========================================
# A random string used to secure session cookies and hashes.
# You can generate one using: python -c "import os; print(os.urandom(24).hex())"
SECRET_KEY=your_super_secret_key_here

# Environment mode ('development' or 'production').
# production = session cookie is sent over HTTPS only -> use it ONLY when the
# site is served with HTTPS (e.g. on AWS with a certificate).
FLASK_ENV=development

# Local `python app.py` only: 1 = auto-reload + debugger. NEVER on a server.
FLASK_DEBUG=1

# Origins allowed to call the API from another address (Vite dev server).
# Behind nginx (Docker/AWS) the site is same-origin. Never use "*".
CORS_ORIGINS=http://localhost:5173

# 1 when running behind nginx (Docker/AWS) so rate limits use the real client IP
BEHIND_PROXY=0

# ==========================================
# Email (Resend — https://resend.com) — used for password reset emails
# ==========================================
# Leave RESEND_API_KEY empty to print emails to the backend console instead.
# With the default sender (onboarding@resend.dev) Resend only delivers to the
# email address your Resend account was registered with.
RESEND_API_KEY=
EMAIL_FROM=SocialApp <onboarding@resend.dev>

# ==========================================
# OpenAI — toxic-content moderation (free endpoint) and AI features
# ==========================================
# Create a key at https://platform.openai.com/api-keys
# Leave empty to skip moderation (content is allowed, a warning is printed).
# Moderation is free; AI Assist (chat) needs prepaid credits on the account.
OPENAI_API_KEY=
# Chat model for AI Assist
OPENAI_MODEL=gpt-4.1-mini

# Agents (bots): seconds between two bot actions in run_agents.py
# (each action = at most one small OpenAI request)
AGENT_INTERVAL_SECONDS=60

# Base URL of the frontend, used to build the link inside reset emails
FRONTEND_URL=http://localhost:5173
